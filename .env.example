# ==============================================================================
# LUMIBOOTH DSLR FRAME DESIGNER - ENVIRONMENT VARIABLES TEMPLATE
# Sao chép file này thành .env để chạy local hoặc cấu hình trên Vercel Environment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & SUPABASE (Backend API Server & Database)
# ------------------------------------------------------------------------------
# Chuỗi kết nối PostgreSQL (Drizzle ORM)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]

# Supabase REST API & Service Key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Mật khẩu tài khoản Quản trị viên
ADMIN_PASSWORD=your_secure_admin_password

# Secret key mã hóa Token JWT / Session
AUTH_SECRET=lumibooth-ai-secret-key-2026

# ------------------------------------------------------------------------------
# 3. AI & INTEGRATIONS (Optional)
# ------------------------------------------------------------------------------
# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key

# Telegram Bot thông báo
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ------------------------------------------------------------------------------
# 4. CENTRAL ID SYSTEM BACKEND
# ------------------------------------------------------------------------------
# Backend trung tam quan ly auth, credit, billing, payOS, Cloudinary pool va frame.
VITE_ID_SYSTEM_API_BASE_URL=http://localhost:8081
VITE_ID_SYSTEM_CLIENT_ID=tool-template-dslr
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME PORTS
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
